{
  "name": "git-file-explorer-colors",
  "version": "1.0.2",
  "description": "Color Obsidian's File Explorer from Git status.",
  "main": "main.js",
  "packageManager": "npm@10.9.2",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "node esbuild.config.mjs production",
    "check": "tsc --noEmit",
    "test": "tsc -p tsconfig.tests.json && node --test build-tests/tests/status-model.test.js",
    "sync:scratch": "bash scripts/sync-scratch-vault.sh",
    "validate": "npm run check && npm run test && npm run build",
    "version": "node version-bump.mjs && git add manifest.json versions.json"
  },
  "keywords": [
    "obsidian",
    "plugin",
    "git"
  ],
  "author": "Peter Szymczak",
  "license": "MIT",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "devDependencies": {
    "@types/node": "^22.14.1",
    "esbuild": "^0.25.2",
    "obsidian": "^1.7.2",
    "typescript": "^5.8.3"
  }
}
